# Runtime
NODE_ENV=development
PORT=4000

# Public site URLs. CORS_ORIGIN accepts a comma-separated allowlist.
FRONTEND_URL=https://prioritybags.in
CORS_ORIGIN=http://localhost:3000,https://prioritybags.in,https://www.prioritybags.in,https://ecommerce-website-frontend-woad.vercel.app

# Generate independent high-entropy secrets; never commit real values.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Supabase server credentials (service-role key is backend-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay: use rzp_test_* credentials until the launch checklist passes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional email.
RESEND_API_KEY=
FROM_EMAIL=noreply@prioritybags.in

# Optional shopping assistant.
ANTHROPIC_API_KEY=

# Development-only manual verification endpoint secret.
DEV_VERIFY_SECRET=
