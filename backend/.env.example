# ─────────────────────────────────────────────────────────────
# Priority Bags Backend — Environment Variables Template
# Copy this file to backend/.env and populate your secrets.
# ─────────────────────────────────────────────────────────────

# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Supabase (PostgreSQL Database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cloudinary (Media / Product Images CDN)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Payments & Orders)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Email Services (Resend or SMTP)
FROM_EMAIL=noreply@prioritybags.in
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: SMTP Configuration (fallback if not using Resend)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Anthropic Claude API (Product Assistant Chatbot)
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here
