# Leave VITE_API_URL empty in development — the Vite proxy forwards /api/* to localhost:4000
# In production set this to your backend URL, e.g. https://api.prioritybags.in
VITE_API_URL=

# Razorpay publishable key (test: rzp_test_*, live: rzp_live_*)
VITE_RAZORPAY_KEY_ID=

# Shipping constants — must match backend config
VITE_SHIPPING_THRESHOLD=1499
VITE_SHIPPING_FEE=99
VITE_GRIEVANCE_OFFICER_NAME=

# Instagram live auto-sync for the #PriorityBags home section (InstagramShowcase).
# Set ONE of the following to pull your latest posts automatically.
# 1) Behold.so (free): create a feed at https://behold.so, then paste its Feed ID here.
VITE_BEHOLD_FEED_ID=
# 2) Or point directly at any JSON feed URL (Behold, or your own endpoint).
#    If set, this takes priority over VITE_BEHOLD_FEED_ID.
VITE_INSTAGRAM_FEED_URL=
