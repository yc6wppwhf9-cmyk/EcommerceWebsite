{
  "name": "ecommerce-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=priority-bags-frontend",
    "dev:backend": "npm run dev --workspace=priority-bags-backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "npm run build --workspace=priority-bags-frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
