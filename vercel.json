{
  "buildCommand": "npm run build --workspace=priority-bags-frontend",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/optimized/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ecommercewebsite-5z8k.onrender.com/api/$1" },
    { "source": "/sitemap.xml", "destination": "https://ecommercewebsite-5z8k.onrender.com/api/sitemap.xml" },
    { "source": "/shopping-feed.xml", "destination": "https://ecommercewebsite-5z8k.onrender.com/api/shopping-feed.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
